# -----------------------------------------------------------------------------
# Core settings
# -----------------------------------------------------------------------------
# Required for SEO data features. See docs/DATAFORSEO_API_KEY.md.
# DATAFORSEO_API_KEY=

# Optional: a free Google PageSpeed Insights key runs the site audit's
# Lighthouse checks while DATAFORSEO_API_KEY is unset. With the Chrome UX Report
# API enabled on it, it also runs real-user Core Web Vitals, with or without
# DATAFORSEO_API_KEY. See docs/SELF_HOSTING_GOOGLE_APIS.md.
# GOOGLE_PAGESPEED_API_KEY=

# Optional, used only while DATAFORSEO_API_KEY is unset: a Google Places API
# (New) key runs the Maps rank grid, local SERP, local business search and
# place details, capped below Google's free monthly usage. See
# docs/SELF_HOSTING_GOOGLE_APIS.md.
# GOOGLE_PLACES_API_KEY=

# Optional, used only while DATAFORSEO_API_KEY is unset: a Bright Data SERP API
# key and zone run rank tracking, get_serp_results and find_serp_competitors on
# Bright Data's live Google SERP, capped below its free monthly requests. See
# docs/SELF_HOSTING_GOOGLE_APIS.md.
# BRIGHTDATA_API_KEY=
# BRIGHTDATA_SERP_ZONE=

# Optional, used only while DATAFORSEO_API_KEY is unset: keyword volumes and
# ideas from the Google Ads API Keyword Planner. An OAuth client of the Google
# Cloud project that holds your Google Ads API access, the Ads account to read
# (digits only) and, when you reach it through a manager account, the manager's
# ID. BETTER_AUTH_SECRET is also required (it encrypts the stored grant). Then
# connect Google Ads under a project's Settings → Integrations. See
# docs/SELF_HOSTING_GOOGLE_APIS.md.
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=
# GOOGLE_ADS_CUSTOMER_ID=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Optional app port
# PORT=3001

# Optional reverse-proxy hosts for Docker self-hosting
# ALLOWED_HOST=yourdomain.com

# Optional image tag override for Docker self-hosting
# OPEN_SEO_IMAGE=ghcr.io/every-app/open-seo:latest

# -----------------------------------------------------------------------------
# Auth mode
# -----------------------------------------------------------------------------
# - cloudflare_access: validate Cloudflare Access JWTs (recommended for deploys)
# - local_noauth: local trusted mode with injected admin user (admin@localhost)
# - hosted: Better Auth email/password + organization mode
#
# Defaults to cloudflare_access when unset.
# AUTH_MODE=cloudflare_access

# Optional, AUTH_MODE=local_noauth only: require this key for the web app
# (browser login: any username, this key as password) and MCP
# (https://your-domain/mcp?key=KEY or Authorization: Bearer KEY).
# Generate with: openssl rand -hex 32
# SELFHOST_ACCESS_KEY=

# Required when AUTH_MODE=cloudflare_access. See docs/SELF_HOSTING_CLOUDFLARE.md.
# TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# POLICY_AUD=your-cloudflare-access-aud-tag

# Required when AUTH_MODE=hosted
# BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# BETTER_AUTH_URL=http://localhost:3001
# GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id
# GOOGLE_CLIENT_SECRET=replace-with-your-google-oauth-client-secret
# POSTHOG_PUBLIC_KEY=replace-with-your-posthog-project-api-key
# POSTHOG_HOST=https://us.i.posthog.com
# LOOPS_API_KEY=replace-with-your-loops-api-key
# LOOPS_TRANSACTIONAL_VERIFY_EMAIL_ID=replace-with-your-loops-verify-template-id
# LOOPS_TRANSACTIONAL_RESET_PASSWORD_ID=replace-with-your-loops-reset-template-id
# LOOPS_TRANSACTIONAL_INVITATION_ID=replace-with-your-loops-invitation-template-id

# Optional in self-hosted modes. Required if you want Google Search Console
# integration and MCP tools. BETTER_AUTH_SECRET is also required for GSC (it
# encrypts the stored OAuth tokens). See docs/SELF_HOSTING_GOOGLE_SEARCH_CONSOLE.md.
# GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id
# GOOGLE_CLIENT_SECRET=replace-with-your-google-oauth-client-secret
# BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Optional: Context.dev key for the site audit "Render JavaScript" option.
# Docker has no browser, so the option is disabled until this is set.
# CONTEXT_API_KEY=
# Local development only: attach a remote Cloudflare Browser Run binding to
# the audit worker (needs `wrangler login`).
# AUDIT_BROWSER_RENDERING=true
